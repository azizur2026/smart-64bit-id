# s64bt.config - S64BT test package configuration
# Single source of truth for all tests.
# Carries the test package version, NOT the identifier format version.

PKG_VERSION=0
PKG_REVISION=04
PKG_DATE="Nov 14, 2026"

# Database controller
# Currently only "mysql" is implemented. "postgresql" is reserved.
DB_CONTROLLER=mysql

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_SOCKET=/opt/lampp/var/mysql/mysql.sock

DB_NAME_TEST=s64_test
DB_NAME_CT07=s64_ct07_disposable
DB_NAME_DRYRUN_PREFIX=s64_dryrun_

CT07_WORKERS=1000
CT07_OPS_PER_WORKER=100
CT07_CLASS_ID=1

EVIDENCE_DIR=gcc/evidence
